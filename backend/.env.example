# ─────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────
PORT=3001
# URL pubblico del sito (usato nei messaggi, es. link "scegli un altro orario")
PUBLIC_URL=https://tuodominio.it
# Origini ammesse per le chiamate API (solo se frontend e backend stanno su domini diversi)
ALLOWED_ORIGINS=http://localhost:5173
# true = non invia niente davvero, stampa tutto nel terminale (per provare il sito in locale)
DRY_RUN=true
# Cartella dove salvare le prenotazioni (bookings.json)
DATA_DIR=./data

# ─────────────────────────────────────────────
#  TU (amministratore)
# ─────────────────────────────────────────────
ADMIN_NAME=Simone Redaelli
# La tua Gmail: è l'account Google che crea gli eventi e invia le email
ADMIN_EMAIL=tuamail@gmail.com
# Il TUO WhatsApp personale, con prefisso internazionale, senza + e senza spazi
ADMIN_PHONE=393331234567

# ─────────────────────────────────────────────
#  WHATSAPP CLOUD API (Meta)
# ─────────────────────────────────────────────
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Una stringa a caso che inventi tu, la stessa che metti nel pannello Meta
WA_VERIFY_TOKEN=metti-una-stringa-segreta
# App Dashboard → Impostazioni app → Di base → Chiave segreta
WA_APP_SECRET=
WA_API_VERSION=v25.0
WA_TEMPLATE_LANG=it
# true = usa i template approvati (necessario in produzione)
# false = messaggi liberi/bottoni interattivi (funziona solo se ti hanno scritto nelle ultime 24h, utile per test)
WA_USE_TEMPLATES=true

# ─────────────────────────────────────────────
#  GOOGLE (Calendar + Meet + Gmail)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lo ottieni con: npm run google-auth
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
